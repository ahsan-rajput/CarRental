<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Car Rental</title>

    <!-- Bootstrap 5.3 CSS (sirf aik dafa) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body class="d-flex flex-column min-vh-100">

    <!-- Dark navbar: small screens par collapse ho jati hai -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" asp-controller="Cars" asp-action="Index">Car Rental</a>

            <!-- Toggle button -->
            <button class="navbar-toggler" type="button"
                    data-bs-toggle="collapse" data-bs-target="#mainNav"
                    aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- Collapsible menu -->
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Cars" asp-action="Index">Available Cars</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Cars" asp-action="Booked">Booked Cars</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Page content: centred container + vertical spacing -->
    <main class="container my-4 flex-grow-1">
        @RenderBody()
    </main>

    <!-- Footer: top border + centred text -->
    <footer class="border-top text-center py-3">
        <div class="container">All rights reserved</div>
    </footer>

    <!-- Bootstrap 5.3 JS bundle (sirf aik dafa) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>